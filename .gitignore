data/backups/

# ==========================================================================
# TRAIN/VALIDATION scratch dumps -- numbers are reconciled in prose in each
# plan's own results doc / preregistration; these raw dumps are re-derivable
# by re-running the script named there. data/ is bind-mounted into the
# running containers, so a committed dump under it breaks CI's git reset on
# the deploy host (912e004) -- hence a glob per version rather than trusting
# every future session to remember to list its own ad-hoc filename.
# ==========================================================================
data/replay_r_sequence.json
data/replay_result.json
data/v32_train_lift.json
data/v32_validation.json
data/v32_factor_correlation.json
# A GLOB rather than the three named files (v33_trend_overlap / v33_train /
# v33_validation), because the deploy breakage this prevents is caused by ANY
# new dump under data/, and the ad-hoc ones are exactly the ones nobody
# remembers to list -- Task 7's own reproducibility re-run wrote a fourth
# (data/v33_train_verify.json) that three explicit lines would have missed.
data/v33_*.json
# Same reason and same glob shape for v34's RS-gate measurement dumps
# (data/v34_train.json, data/v34_train_rows.json, data/v34_validation.json),
# re-derivable via scripts/backtest/measure_rs_gate_effect.py.
data/v34_*.json
# data/v35_validation.json and data/v35_validation_off.json were briefly
# tracked and reproduced the identical deploy breakage. Extension-less (not
# `*.json` like v33) because v35's scratch also includes run logs, shell
# scripts and summary .txt dumps under the same prefix -- all equally
# unwanted under a bind-mounted data/.
data/v35_*
# v68's dead-cat-bounce veto TRAIN/VALIDATION population dumps
# (data/v68_train_dcb.json, data/v68_validation_dcb.json), re-derivable via
# scripts/backtest/measure_dcb_veto.py. Same glob shape and reason as v33/v34.
data/v68_*.json

# ==========================================================================
# Test/build byproducts
# ==========================================================================
__pycache__/
backtest_range_summary.txt
# pytest scratch: .pytest-last-run.log is where scripts/dev/testrun.py parks
# full pytest output so only its 1-3 line verdict reaches the caller's context.
.pytest_cache/
.pytest-last-run.log

# ==========================================================================
# Logs
# ==========================================================================
logs/
# Noisy raw run logs only -- narrowed from a blanket docs/superpowers/results/
# rule (fafcdc9) that hid the whole directory, including *.md/*.json
# validation deliverables the backtest methodology in CLAUDE.md requires be
# committed. Caught when Task E80's results doc silently failed to `git add`.
docs/superpowers/results/*.log

# ==========================================================================
# Frontend (Angular SPA, sub-project 4). `frontend/` has its own .gitignore
# from `ng new`; these are here as well because the root file is where
# anyone looks, and because static/app/ is OUTSIDE frontend/ and its own
# file therefore cannot cover it.
# ==========================================================================
frontend/node_modules/
frontend/dist/
frontend/.angular/
# The built SPA, copied here by the Dockerfile's frontend stage (NG33) and
# served by Flask. A build artefact -- never committed, or the image would
# ship whichever bundle someone last built by hand.
swingbot/admin/static/app/

# ==========================================================================
# Editor / tooling config and local-only Claude Code state
# ==========================================================================
.vscode/
.claude/settings.local.json
.claude/worktrees/

# Local-machine-specific: shells out through WSL to a hardcoded key path.
# Never committed -- see the file's own header for what it does.
scripts/ops/ssh-hetzner.sh

# ==========================================================================
# Brainstorming and vendored reference material -- not source, never shipped
# ==========================================================================
# Brainstorming visual-companion sessions: mockups and server state.
.superpowers/
# HKUDS/Vibe-Trading, vendored locally for reading only (see the Origin:
