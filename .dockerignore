# Runtime/state files -- these live on the host via the bind mount in
# docker-compose.yml, not baked into the image.
data/
logs/
.env
.env.bak
.env.example
exports/

# Python/dev cruft
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.git/
.gitignore
*.egg-info/

# Dev tooling -- not needed inside the container
.vscode/
.claude/
*.bak

# Docker files themselves don't belong in the image context
Dockerfile
docker-compose.yml
.dockerignore

# The SPA's build artefacts and its ~1,100 installed packages.
#
# `frontend/` itself is NOT excluded, and cannot be: .dockerignore applies to
# the whole build context, so hiding it would starve the `frontend` build
# stage of the sources it exists to compile. What these three lines do is
# keep the HOST's node_modules out of the context entirely -- so the build
# stage's own `npm ci` result is never overwritten by whatever happens to be
# installed on the developer's machine, and the context stays small.
#
# Consequence worth knowing: the runtime stage's `COPY . .` therefore does
# include frontend/src and the manifests. A few hundred KB of TypeScript
# that is never executed -- the bundle it produces arrives separately from
# the build stage. Excluding it would need a .dockerignore per stage, which
# Docker does not have.
frontend/node_modules/
frontend/dist/
frontend/.angular/
