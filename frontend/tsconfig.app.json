/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    /* Test-only, and it reads the token file off disk with `node:fs`. The app
     * build compiles with `"types": []`, so leaving it in `include` fails the
     * build on `node:path` and `process` — it belongs to tsconfig.spec.json,
     * which has the node types, and is listed there. */
    "src/test-setup.ts"
  ]
}
