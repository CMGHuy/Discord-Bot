# --- Discord Connection ---

DISCORD_TOKEN=your-bot-token-here

# Main channel where new trade alerts are posted.
#
# This channel NEVER notifies: everything the bot posts here -- alerts, the
# "bot online" notice, session welcome/goodbye lines, config-change notices,
# scan progress, fill events -- carries Discord's @silent flag. Messages are
# still delivered and rendered in full and the channel still marks unread;
# they just raise no push or desktop notification. Set
# DISCORD_CHANNEL_TRADES_SIMPLE_ID below if you want a channel that does ping.
DISCORD_CHANNEL_TRADES_ID=your-alerts-channel-id

# Optional mirror of the alerts channel above, stripped to a short text
# message: ticker, direction (LONG/SHORT), confidence level + score, horizon,
# setup, entry, TP1, TP2, SL. No chart image is attached. Same signals as the
# main channel (firehose-routed ones included) -- only the rendering differs.
# Leave blank to turn the simple mirror off.
#
# This is where the NOTIFICATION lives. DISCORD_CHANNEL_TRADES_ID is always
# silent, so with no mirror configured the bot posts nothing that pings at
# all -- set this if you want to be notified when a signal fires. The mirror
# itself is never silenced.
DISCORD_CHANNEL_TRADES_SIMPLE_ID=your-alerts-channel-simple-id

# Channel where WIN/LOSS notifications get posted when a trade closes.
# Separate from the main alert channel so closed-trade results don't get
# lost among new signals.
DISCORD_CHANNEL_TRADES_HISTORY_ID=your-closed-trades-channel-id

# Channel where the end-of-session retrospective is posted on weekdays
# (Mon–Fri at SESSION_END_HOUR:15 Berlin time). Leave blank to fall back
# to DISCORD_CHANNEL_TRADES_HISTORY_ID.
DISCORD_CHANNEL_RETROSPECTIVE_ID=your-retrospective-channel-id

# Channel for non-tier-A alerts.
DISCORD_CHANNEL_FIREHOSE_ID=

# --- Scanning & Session ---

# Trading session window (Europe/Berlin time, DST-aware). The bot scans
# continuously during this window instead of just once a day.
SESSION_START_HOUR=8
SESSION_END_HOUR=23

# How often to scan during the session, in minutes. Every scan both looks
# for new trades AND checks all open trades for near-close proximity.
SCAN_INTERVAL_MINUTES=5

# A signal must appear the same way on this many CONSECUTIVE scans before
# it's confirmed and alerted -- filters flicker from today's still-forming
# daily candle. Higher = fewer false alarms, but slower to alert.
SIGNAL_CONFIRMATION_SCANS=2

# DEBUG shows per-horizon scanning detail and full confidence breakdowns
# for every scenario checked, not just the ones that alert.
LOG_LEVEL=INFO

# --- Trade Filters & Risk ---

# Hard filter, enforced exactly as set: a scenario is dropped entirely
# (not shown, not scored) unless its target sits at least this much
# away from TODAY'S CURRENT PRICE. No exceptions for a close miss.
MIN_REWARD_PCT=2.0

# Hard filter: dropped entirely if the stop sits closer than this to
# entry -- too exposed to ordinary daily noise. No exceptions.
MIN_STOP_DISTANCE_PCT=2.0

# Hard filter: dropped entirely if the stop sits further than this from
# entry. Keep this in the 5–7% range for disciplined position sizing.
MAX_STOP_LOSS_PCT=7.0

# Hard filter: dropped entirely unless the reward:risk to target 1
# clears this ratio. No exceptions for a close miss.
MIN_RISK_REWARD_RATIO=1.5

# Ceiling on how far a target may sit, as a multiple of the plan's own risk.
# A real level further out doesn't disqualify the setup -- the target is
# placed AT the ceiling instead, and that further level becomes TP2.
MAX_RISK_REWARD_RATIO=2.5

# How close (as a %) an independent strategy's own predicted level has
# to land to a scenario's actual target/stop price to count as
# confirming it (see MIN_TARGET_CONFLUENCE_COUNT below).
CONFLUENCE_DEVIATION_PCT=5.0

# A scenario is flagged unless at least this many DISTINCT strategies
# land within CONFLUENCE_DEVIATION_PCT of the target price.
# 1 disables this requirement.
MIN_TARGET_CONFLUENCE_COUNT=2

# Only Level 4 (High) and above auto-alert. Lower levels are still
# computed and shown via !check but won't post automatically.
MIN_ALERT_CONFIDENCE_LEVEL=4

# Score alerts with the merged factor registry (v32), so relative strength,
# multi-timeframe alignment and market breadth affect which alerts fire.
# Off = the legacy 1-5 score. Enable only after VALIDATION.
UNIFIED_CONFIDENCE=false

# Two signals on the same ticker/direction with entry, SL, and TP all
# within this % of each other get merged into one alert.
DEDUP_TOLERANCE_PCT=2.0

# Post a warning when an open trade's price gets within NEAR_CLOSE_THRESHOLD_PCT
# of its SL/TP. Set to false to temporarily silence these without losing the
# threshold below -- SL/TP hits themselves are unaffected either way.
NEAR_CLOSE_ALERTS_ENABLED=false

# How close (in %) the current price must get to a trade's stop-loss or
# take-profit before a near-close warning posts to
# DISCORD_CHANNEL_TRADES_HISTORY_ID. Fires once per approach.
NEAR_CLOSE_THRESHOLD_PCT=2.0

# --- Options / Opex ---
OPEX_CAUTION_ENABLED=false
OPEX_MONTHLY_CONFIDENCE_BUMP=1
OPEX_MONTHLY_CONFLUENCE_BUMP=1
OPEX_WEEKLY_CONFLUENCE_BUMP=1
OPEX_NEAR_CLOSE_SUPPRESS_MINUTES=60
OPEX_STOP_WIDEN_PCT=10.0
OPEX_SIZE_REDUCTION_PCT=25.0

# If a trade reaches NEAR_TP_TIMEOUT_THRESHOLD_PCT of the way to its target
# (as a % of the entry -> target 1 distance) and then sits there without
# actually touching the target for NEAR_TP_TIMEOUT_MINUTES, it's closed early
# at the live price to lock in the profit already made instead of risking it
# waiting for the exact target price. Dropping back below the threshold
# resets the clock. Set NEAR_TP_TIMEOUT_ENABLED=false to disable entirely.
#
# A faster exit than the full timeout: once price is in the near-TP zone,
# NEAR_TP_STALL_CHECK_MINUTES/_MAX_FLUCTUATION_PCT close the trade early if
# price hasn't moved more than the fluctuation % within that shorter window
# (must be less than NEAR_TP_TIMEOUT_MINUTES).
NEAR_TP_TIMEOUT_ENABLED=true
NEAR_TP_TIMEOUT_THRESHOLD_PCT=80.0
NEAR_TP_TIMEOUT_MINUTES=10
NEAR_TP_STALL_CHECK_MINUTES=5
NEAR_TP_STALL_MAX_FLUCTUATION_PCT=0.5

# How many past trading days the daily retrospective remembers, so it can
# notice repeating problems (e.g. "3rd day in a row") instead of treating
# every day in isolation with no memory of what was said yesterday.
RETROSPECTIVE_HISTORY_DAYS=60

# The bot holds at most one trade per ticker.
REVERSAL_ENABLED=true

# A trade must have been open at least this long before it can be flipped.
REVERSAL_MIN_HOLD_HOURS=24.0

# After reversing a ticker, no further reversal on it for this long.
REVERSAL_COOLDOWN_HOURS=48.0

# How much better the opposite setup's confidence score must be than the
# open trade's before it can flip it.
REVERSAL_MIN_CONF_MARGIN=10.0

# Hard ceiling on reversals per ticker per calendar day, regardless of how
# good the signals look.
REVERSAL_MAX_PER_DAY=1

# Require bearish setups to sit in the bottom quartile of combined relative
# strength versus SPY. FX, futures and indices are exempt, and so is any
# scan where the RS benchmark itself failed to compute (SPY/RS-cache
# failure) -- an exemption is never a pass. This does NOT cover a single
# ticker with too little history for its own RS reading: that ticker still
# gets the ambiguous 50.0 sentinel and is judged as if it were a real
# median (docs/strategy.md's RS gate section has the known-gap detail). The
# bullish half is disabled (RS_LEADER_PERCENTILE=0) because it measured
# negative. ON by default since v34's one-shot VALIDATION: 48.50% -> 49.66%
# win rate (+1.17pp) for 4.07% of alert volume, on overlapping confidence
# intervals -- a small improvement, not a proven edge.
RS_GATE=true

# Both values are FROZEN from the v34 TRAIN sweep
# (docs/superpowers/plans/implemented/v34-train-preregistration.md) and must
# not be changed without a new pre-registration and its own VALIDATION shot.

# Bullish setups need combined RS at or above this percentile. 0 disables the
# bullish half of the gate (a percentile is never negative, so every bullish
# setup passes). It ships at 0 because v34's TRAIN sweep found a bullish gate
# NEGATIVE at every threshold measured -- 55/60/65/70/75 cost 28.6%-58.3% of
# alert volume for -0.16 to -3.80pp of win rate.
RS_LEADER_PERCENTILE=0

# Bearish setups need combined RS at or below this percentile. 25 is v34's
# TRAIN-frozen value: the bearish arm's win rate ran monotonically with the
# threshold and only the bottom quartile separated on Wilson intervals
# (32.1% -> 50.0%), for 8.6% of total alert volume.
RS_LAGGARD_PERCENTILE=25

# --- Multi-Timeframe Confluence ---

# Check each ticker's higher-timeframe EMA bias before accepting a signal.
# Counter-trend signals are flagged in the embed and the plan-quality
# score's htf component -- informational only, no score reduction.
HTF_CONFLUENCE_ENABLED=true

# Drop a scenario when the next horizon up trends against it (e.g. a 2w
# bullish setup while the 4w trend is bearish). The longest horizon is
# exempt. Enable only after VALIDATION.
MTF_ADJACENT_GATE=false

# --- Data & Display ---

# How much daily history to pull for live scanning.
DEFAULT_HISTORY_PERIOD=10y

# Fallback currency symbol when a ticker's real currency can't be detected.
CURRENCY_SYMBOL=€

# Market regime benchmark ticker (used to gauge overall market trend).
MARKET_REGIME_TICKER=SPY

# --- Account Defaults ---

# Editable at runtime via !account, stored in account.json after first run.
ACCOUNT_BALANCE=1000000
RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=30
MAX_POSITION_SIZE_PCT=5.0

# How each trade's position size is calculated:
#   risk_pct    -- fixed-fractional (original model): size so a full stop-out
#                  costs exactly RISK_PER_TRADE_PCT% of the account.
#   account_pct -- fixed allocation: the position itself is always exactly
#                  POSITION_SIZE_PCT_OF_ACCOUNT% of the account balance,
#                  regardless of stop distance (e.g. 0.1% of a €1,000,000
#                  account opens a €1,000 position every time).
# Both are editable at runtime via !account sizing / !account positionpct.
POSITION_SIZING_MODE=risk_pct
POSITION_SIZE_PCT_OF_ACCOUNT=0.101

# Only used in 'vol_target'/'min_of_all' sizing mode.
PORTFOLIO_TARGET_DAILY_VOL_PCT=0.7

# Sum of risk-to-stop across every open position never alerts a new entry
# past this % of equity.
PORTFOLIO_HEAT_CAP_PCT=6.0

# Open positions whose 90-day returns correlate above 0.75 with a new
# candidate (or share its sector when price history is too thin to
# correlate) count their heat against this separate, tighter budget -- three
# 'different' 0.9-correlated trades are really one trade at 3x size.
CORRELATED_HEAT_CAP_PCT=3.0

# Sum of risk-to-stop across every open position in the same sector never
# alerts a new entry in that sector past this % of equity.
SECTOR_HEAT_CAP_PCT=3.0

# Caps how many open positions can share one swing horizon (e.g.
MAX_OPEN_PER_HORIZON=4

# Hard currency cap: a trade's position value (shares × entry) never exceeds
# this many currency units, full stop -- applied ON TOP OF (and independent
# of) the %-based caps above.
MAX_POSITION_VALUE_ABSOLUTE=1000

# Hard currency cap: the REAL risk if a trade's stop-loss is hit (final
# shares × stop distance) never exceeds this many currency units, regardless
# of sizing mode, Risk per trade %, or account balance.
MAX_RISK_AMOUNT_ABSOLUTE=100

# Enable a mechanical drawdown-based risk multiplier that cuts position size
# as equity drawdown deepens: no cut at 0-8% DD, 0.75x at 8-12%, 0.50x at
# 12-16%, 0.25x at 16-20%, and 0.0x (new entries paused) above 20%.
DD_THROTTLE_ENABLED=false

# --- Secondary Alerts (optional) ---

# Send email alerts via SMTP in addition to Discord.
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Send push notifications via ntfy.sh (free, no account needed).
ALERT_PUSH_ENABLED=false
NTFY_TOPIC=

# Secondary channels (email, push) only fire for setups at this confidence
# level or above.
# One of: 1, 2, 3, 4, 5
SECONDARY_ALERT_MIN_CONFIDENCE=4

# --- Plan Engine v2 rollout (see README "Plan Engine v2" section) ---
# Defaults ship fully live (on/true/true) for immediate deployment. Set
# PLAN_ENGINE_V2=shadow first instead if you'd rather compare v2 plans
# against legacy numbers for a few scan sessions before trusting them live.

# off = legacy alerts | shadow = v2 plans logged to data/shadow_plans.jsonl
# but not posted | on = alerts price and emit v2 plans (badges, TP1/TP2).
PLAN_ENGINE_V2=on
# At TP1 close 50%, stop to break-even, runner trails toward TP2.
SCALE_OUT_ENABLED=true
# 60s monitor drives the plan lifecycle (fills, BE moves, partials, trail)
# with a Discord alert per transition; !plans shows the live board.
INTRADAY_MANAGER_V2=true

# --- Data Sources (optional) ---

# API key for Financial Modeling Prep (https://financialmodelingprep.com),
# used by the FMP crawler (scripts/data/fmp_crawl.py) to pull prices, fundamentals,
# earnings, transcripts, etc. Works on the free tier (gated endpoints are
# skipped) and any paid tier. Leave blank to disable FMP crawling.
FMP_API_KEY=

# --- Admin UI ---

# Protects the admin web UI with HTTP Basic Auth. CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Port the admin UI listens on (docker-compose.yml maps this to the host).
ADMIN_PORT=1234
DASHBOARD_REFRESH_SECONDS=10
LOGS_REFRESH_SECONDS=10

# Optional: exposing this admin UI at a real domain via a Cloudflare Tunnel
# needs CLOUDFLARE_TUNNEL_TOKEN and COMPOSE_PROFILES=tunnel -- deliberately
# NOT listed as settings here, since they're read by docker-compose.yml, not
# by swingbot/config.py (same reason SWING_BOT_IMAGE isn't here either; see
# tests/test_env_example_sync.py). Full setup: docs/CLOUDFLARE_TUNNEL.md.


# --- Discord Alerts ---

# 'detailed' (default) shows every section this bot has always shown.
# One of: detailed, compact
ALERT_EMBED_LAYOUT=detailed

# Post a curated 'Top plans today' digest (VALIDATED plans only, ranked by
# follow score) to the alerts channel right after the trading session closes
# for the day.
DAILY_DIGEST_ENABLED=false

# Default number of plans shown by `!top` when no explicit count is given,
# and the daily Top-Plans digest's plan count (Task B37).
DIGEST_MAX_PLANS=3

# --- Execution Realism ---

# Every backtest v1 entry/exit fill is worsened by this many basis points --
# buys fill higher, sells fill lower.
SLIPPAGE_BPS=5

# Flat commission charged per fill (entry and exit each pay this once, so a
# round trip pays it twice).
COMMISSION_PER_TRADE=1.0

# Dollar risk-per-trade assumed when converting commission into an R
# deduction (default $100 risked/trade = 1% of a $10k account).
COMMISSION_RISK_BASIS=100.0

# --- Universe & Scanning ---

# 20-day average of Close x Volume must clear this floor or the ticker is
# skipped for NEW signals this scan (existing open trades keep being
# monitored regardless -- see swingbot/core/marketdata/universe.py).
UNIVERSE_MIN_DOLLAR_VOL=20000000

# Last close below this floor skips the ticker for new signals this scan --
# filters penny stocks, whose price action/spreads behave differently from
# the swing-trade universe this bot is tuned for.
UNIVERSE_MIN_PRICE=5.0

# What the scanner covers.
# One of: watchlist, sp500, sp500_top150, etfs, sp500+etfs
SCAN_UNIVERSE=watchlist

# New entries are blocked when the ticker's next earnings date is within
# this many days (0 = off).
EARNINGS_BLACKOUT_DAYS=0

# Thread-pool size for per-ticker scanning.
SCAN_WORKERS=4

# How old market_data/daily/{TICKER}.csv may be before a scan treats the
# ticker as cold and refetches it. Below data_refresh's own 12h daily window.
SCAN_CACHE_MAX_AGE_HOURS=6

# Cold-ticker count at or below which the scan fetches sequentially; above it,
# the cold list is fanned out across FETCH_WORKERS processes.
COLD_FETCH_PROCESS_THRESHOLD=10

# Process-pool size for the cold fetch and the offline replay. 0 = auto,
# max(1, cpu_count() - 1). PROCESSES, not threads -- see config.py.
FETCH_WORKERS=0

# While the bot runs, keep market_data/{timeframe}/{TICKER}.csv current for
# the training timeframes (monthly, weekly, daily, hourly).
MARKET_DATA_AUTO_REFRESH=true

# How often the auto-refresh loop WAKES UP.
MARKET_DATA_REFRESH_MINUTES=60

# Comma-separated timeframe folders to keep current.
MARKET_DATA_TIMEFRAMES=monthly,weekly,daily,hourly

# Restricts each strategy's entries to the market regimes listed for it in
# swingbot/core/market/strategy_types.py:REGIME_ALLOW
# (entry_filters.apply_regime_gate).
REGIME_GATES_ENABLED=false

# Moves a stop out beyond a support/resistance level that price has actually
# tested and held, instead of leaving it at the ATR default inside that
# noise (swingbot/core/market/levels_lifecycle.py).
LEVEL_LIFECYCLE_STOPS_ENABLED=true

# Adds anchored-VWAP levels (swing-pivot, highest-volume and 52-week-extreme
# anchors, swingbot/core/edge/factors.py:avwap_anchors) to the candidate
# level map as a 12th price-producing strategy family, shifting confluence
# counts. DEFAULT-ON since 2026-08-20 (plan v35) on a NON-INFERIORITY basis,
# not a demonstrated edge -- its one-shot VALIDATION moved pooled win rate
# -0.084pp with heavily overlapping Wilson intervals. Budget spent (two
# shots counting E33); see config.py's help text for the full record.
AVWAP_LEVELS_ENABLED=true

# Once per plan, at PARTIAL and +1R, posts a SUGGESTION to add size with the
# add's stop at the original entry
# (swingbot/core/planning/plan_manager.py:maybe_pyramid).
PYRAMIDING_ENABLED=false

# Adds every high- and low-volume node of the 180-day volume-at-price
# histogram (swingbot/core/market/levels.py:volume_profile_nodes) to the candidate
# level map, on top of the single highest-volume node already used.
VOLUME_PROFILE_NODES_ENABLED=false

# Replaces the legacy per-alert trade chart with the composed decision one-
# pager (swingbot/core/charts/decision_chart.py:render_decision_chart --
# main panel, weekly/RS/sizing/quality side panels) built by
# build_decision_context.
DECISION_CHART_ENABLED=false

# Alert-flood control for large universes: the best MAX_ALERTS_PER_SCAN
# alerts (by follow score, commands/scanning.py:_ordered_alerts' existing
# ranking) post in full; the rest collapse into one digest line on the last
# alert instead of flooding the channel.
MAX_ALERTS_PER_SCAN=10

# Scales the ATR-multiple stop distance by the P90 maximum adverse excursion
# of that strategy's own journaled WINNERS
# (swingbot/core/edge/stops.py:mae_informed_stop_mult, clamped to 0.8-1.3x).
DATA_DRIVEN_STOPS_ENABLED=false
